@{ var current = ViewContext.RouteData.Values["page"]?.ToString() ?? ""; string Active(string page) => current.Equals(page, StringComparison.OrdinalIgnoreCase) ? "active" : ""; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AgriFlow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="buyer-body">
    <div class="buyer-shell">
        <aside class="buyer-sidebar">
            <a asp-page="/Buyer/Dashboard" class="buyer-brand"><i class="bi bi-sprout"></i><span>AgriFlow</span></a>
            <div class="buyer-label">BUYER WORKSPACE</div>
            <nav class="buyer-nav" aria-label="Buyer navigation">
                <a asp-page="/Buyer/Dashboard" class="@Active("/Buyer/Dashboard")"><i class="bi bi-grid-1x2"></i><span>Overview</span></a>
                <a asp-page="/Buyer/Marketplace" class="@Active("/Buyer/Marketplace")"><i class="bi bi-shop"></i><span>Marketplace</span></a>
                <a asp-page="/Buyer/Orders" class="@Active("/Buyer/Orders")"><i class="bi bi-box-seam"></i><span>My orders</span></a>
                <a asp-page="/Buyer/Invoices" class="@Active("/Buyer/Invoices")"><i class="bi bi-receipt"></i><span>Invoices</span></a>
            </nav>
            <div class="buyer-user">
                <div class="buyer-avatar">@(User.Identity?.Name?.FirstOrDefault() ?? 'B')</div>
                <div class="buyer-user-details"><strong>@User.Identity?.Name</strong><small>Business buyer</small></div>
                <form method="post" asp-page="/Account/Logout"><button type="submit" title="Sign out" aria-label="Sign out"><i class="bi bi-box-arrow-right"></i></button></form>
            </div>
        </aside>
        <main class="buyer-content">
            <header class="buyer-topbar">
                <span class="buyer-breadcrumb">Buyer workspace <b>/</b> @ViewData["Title"]</span>
                <div class="buyer-top-actions"><span class="buyer-search"><i class="bi bi-search"></i> Search</span><button class="buyer-notification" type="button" aria-label="Notifications"><i class="bi bi-bell"></i><span></span></button><span class="buyer-date">@DateTime.Now.ToString("ddd, dd MMM yyyy")</span></div>
            </header>
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
