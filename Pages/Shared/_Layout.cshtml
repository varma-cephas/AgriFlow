<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AgriFlow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/agriflow.css" asp-append-version="true" />
</head>
<body class="af-body">
    <partial name="_Sidebar" />

    <div class="af-main">
        <partial name="_TopBar" />
        <main role="main" class="af-page">
            @RenderBody()
        </main>
    </div>

    <partial name="_ToastPartial" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (() => {
            const toastElement = document.getElementById('appToast');
            if (toastElement && window.bootstrap) {
                window.bootstrap.Toast.getOrCreateInstance(toastElement, { autohide: true, delay: 5000 }).show();
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
