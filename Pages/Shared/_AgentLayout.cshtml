<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AgriFlow Agent Workspace</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="agent-body">
    <div class="agent-shell">
        <aside class="agent-sidebar">
            <a asp-page="/Agent/Dashboard" class="agent-brand">
                <i class="bi bi-sprout"></i> AgriFlow
            </a>
            <div class="agent-label">AGENT WORKSPACE</div>
            <nav class="agent-nav">
                <a asp-page="/Agent/Dashboard" class="@(Context.Request.Path.StartsWithSegments("/Agent/Dashboard") ? "active" : "")">
                    <i class="bi bi-house"></i> Overview
                </a>
                <a asp-page="/Agent/MyFarmers" class="@(Context.Request.Path.StartsWithSegments("/Agent/MyFarmers") ? "active" : "")">
                    <i class="bi bi-people"></i> My farmers
                </a>
                <a asp-page="/Account/RegisterFarmer" class="@(Context.Request.Path.StartsWithSegments("/Account/RegisterFarmer") ? "active" : "")">
                    <i class="bi bi-person-plus"></i> Register farmer
                </a>
                <a asp-page="/Agent/Marketplace" class="@(Context.Request.Path.StartsWithSegments("/Agent/Marketplace") ? "active" : "")">
                    <i class="bi bi-shop"></i> Marketplace
                </a>
            </nav>
            <div class="agent-sidebar-bottom">
                <span class="small">Signed in as</span>
                <strong>@User.Identity?.Name</strong>
                <form method="post" asp-page="/Account/Logout" class="mt-3">
                    <button class="btn btn-sm btn-outline-light w-100" type="submit">Sign out</button>
                </form>
            </div>
        </aside>
        <main class="agent-content">
            <header class="agent-topbar">
                <span class="text-muted small">Agent workspace&nbsp; / &nbsp;@ViewData["Title"]</span>
                <div class="d-flex align-items-center gap-3">
                    <div class="agent-search"><i class="bi bi-search"></i> Search...</div>
                    <i class="bi bi-bell text-muted"></i>
                    <span class="text-muted small">@DateTime.Now.ToString("ddd, dd MMM yyyy")</span>
                </div>
            </header>
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
