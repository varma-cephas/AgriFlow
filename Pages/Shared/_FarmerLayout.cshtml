@{ var current = ViewContext.RouteData.Values["page"]?.ToString() ?? ""; string Active(string page) => current.Equals(page, StringComparison.OrdinalIgnoreCase) ? "active" : ""; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>@ViewData["Title"] - AgriFlow</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head><body class="farmer-body"><div class="farmer-shell"><aside class="farmer-sidebar"><a asp-page="/Farmer/Dashboard" class="farmer-brand"><i class="bi bi-sprout"></i> AgriFlow</a><div class="farmer-label">FARMER WORKSPACE</div><nav class="farmer-nav"><a asp-page="/Farmer/Dashboard" class="@Active("/Farmer/Dashboard")"><i class="bi bi-house"></i> Overview</a><a asp-page="/Farmer/SeedStock" class="@Active("/Farmer/SeedStock")"><i class="bi bi-box-seam"></i> Seed stock</a><a asp-page="/Farmer/Planting" class="@Active("/Farmer/Planting")"><i class="bi bi-flower1"></i> Planting batches</a><a asp-page="/Farmer/Listings" class="@Active("/Farmer/Listings")"><i class="bi bi-tag"></i> My listings</a><a asp-page="/Farmer/Orders" class="@Active("/Farmer/Orders")"><i class="bi bi-truck"></i> Sales & orders</a><a asp-page="/Farmer/Marketplace" class="@Active("/Farmer/Marketplace")"><i class="bi bi-shop"></i> Marketplace</a></nav><div class="farmer-user"><small>Signed in as</small><strong>@User.Identity?.Name</strong><form method="post" asp-page="/Account/Logout"><button class="btn btn-sm btn-outline-light w-100 mt-2">Sign out</button></form></div></aside><main class="farmer-content"><header class="farmer-topbar"><span class="text-muted small">Farmer workspace / @ViewData["Title"]</span><span class="text-muted small">@DateTime.Now.ToString("ddd, dd MMM yyyy")</span></header>@RenderBody()</main></div><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>