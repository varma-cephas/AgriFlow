@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    string Active(string page) => currentPage.Equals(page, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>@ViewData["Title"] - AgriFlow Administration</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head><body class="admin-body"><div class="admin-shell"><aside class="admin-sidebar"><a asp-page="/Admin/Dashboard" class="admin-brand"><i class="bi bi-sprout"></i> AgriFlow</a><div class="admin-label">ADMINISTRATION</div><nav class="admin-nav"><a asp-page="/Admin/Dashboard" class="@Active("/Admin/Dashboard")"><i class="bi bi-house"></i> Overview</a><a asp-page="/Admin/Verification" class="@Active("/Admin/Verification")"><i class="bi bi-shield-check"></i> Verification</a><a asp-page="/Admin/Users" class="@Active("/Admin/Users")"><i class="bi bi-people"></i> Users & roles</a><a asp-page="/Admin/AgentAssignments" class="@Active("/Admin/AgentAssignments")"><i class="bi bi-link-45deg"></i> Agent assignments</a><a asp-page="/Admin/Moderation" class="@Active("/Admin/Moderation")"><i class="bi bi-flag"></i> Moderation</a><a asp-page="/Admin/Orders" class="@Active("/Admin/Orders")"><i class="bi bi-exclamation-triangle"></i> Orders & disputes</a><a asp-page="/Admin/Audit" class="@Active("/Admin/Audit")"><i class="bi bi-file-earmark-text"></i> Audit log</a></nav><div class="admin-user"><small>Signed in as</small><strong>@User.Identity?.Name</strong><form method="post" asp-page="/Account/Logout"><button class="btn btn-sm btn-outline-light w-100 mt-2">Sign out</button></form></div></aside><main class="admin-content"><header class="admin-topbar"><span class="text-muted small">Administration&nbsp; / &nbsp;@ViewData["Section"]</span><div class="d-flex gap-3 align-items-center"><div class="admin-search"><i class="bi bi-search"></i> Search...</div><i class="bi bi-bell"></i><span class="text-muted small">@DateTime.Now.ToString("ddd, dd MMM yyyy")</span></div></header>@RenderBody()</main></div><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>