@using System.Security.Claims
@{
    var role = User.FindFirstValue(ClaimTypes.Role) ?? "";
    var fullName = User.FindFirstValue(ClaimTypes.Name) ?? User.Identity?.Name ?? "";
    var initials = string.Concat(fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2).Select(p => char.ToUpperInvariant(p[0])));
    if (initials.Length == 0) { initials = "?"; }

    var current = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    string workspace;
    (string Icon, string Label, string Url)[] items;
    switch (role)
    {
        case "Farmer":
            workspace = "Farmer workspace";
            items = new[]
            {
                ("bi-house-door", "Overview", "/Farmer/Dashboard"),
                ("bi-box-seam", "Seed stock", "/Farmer/SeedStock"),
                ("bi-flower2", "Planting batches", "/Farmer/PlantingBatches"),
                ("bi-tag", "My listings", "/Farmer/Listings"),
                ("bi-truck", "Sales & orders", "/Farmer/Sales"),
                ("bi-shop", "Marketplace", "/Buyer/Marketplace"),
            };
            break;
        case "Buyer":
            workspace = "Buyer workspace";
            items = new[]
            {
                ("bi-house-door", "Overview", "/Buyer/Dashboard"),
                ("bi-shop", "Marketplace", "/Buyer/Marketplace"),
                ("bi-truck", "My orders", "/Buyer/Orders"),
                ("bi-file-earmark-text", "Invoices", "/Buyer/Invoices"),
            };
            break;
        case "Agent":
            workspace = "Agent workspace";
            items = new[]
            {
                ("bi-house-door", "Overview", "/Agent/Dashboard"),
                ("bi-people", "My farmers", "/Agent/Farmers"),
                ("bi-person-plus", "Register farmer", "/Agent/RegisterFarmer"),
                ("bi-shop", "Marketplace", "/Buyer/Marketplace"),
            };
            break;
        case "Admin":
            workspace = "Administration";
            items = new[]
            {
                ("bi-house-door", "Overview", "/Admin/Dashboard"),
                ("bi-shield-check", "Verification", "/Admin/Verification"),
                ("bi-people", "Users & roles", "/Admin/Users"),
                ("bi-link-45deg", "Agent assignments", "/Admin/Assignments"),
                ("bi-flag", "Moderation", "/Admin/Moderation"),
                ("bi-exclamation-triangle", "Orders & disputes", "/Admin/Orders"),
                ("bi-file-earmark-text", "Audit log", "/Admin/AuditLog"),
            };
            break;
        default:
            workspace = "Workspace";
            items = Array.Empty<(string, string, string)>();
            break;
    }
}
<aside class="af-sidebar">
    <a class="af-logo" href="/Index"><i class="bi bi-flower1"></i> AgriFlow</a>
    <div class="af-workspace">@workspace</div>

    <ul class="af-menu">
        @foreach (var item in items)
        {
            var active = string.Equals(item.Url, current, StringComparison.OrdinalIgnoreCase);
            <li>
                <a href="@item.Url" class="@(active ? "active" : "")" @(active ? "aria-current=page" : "")>
                    <i class="bi @item.Icon"></i> @item.Label
                </a>
            </li>
        }
    </ul>

    <div class="af-usercard">
        <span class="af-avatar">@initials</span>
        <div class="af-user-info">
            <div class="af-user-name">@fullName</div>
            <div class="af-user-sub">@role</div>
        </div>
        <form method="post" asp-page="/Account/Logout" class="m-0">
            <button type="submit" class="af-signout" title="Sign out" aria-label="Sign out"><i class="bi bi-box-arrow-right"></i></button>
        </form>
    </div>
</aside>
