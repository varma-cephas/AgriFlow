@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Breadcrumb"] = "Workspace / Overview";
}

<partial name="_PageHeader" model='new PageHeaderModel {
    Icon = "bi-flower1",
    Title = "Welcome back, " + User.Identity?.Name,
    Subtitle = "You are signed in to AgriFlow Rwanda." }' />

<div class="af-card">
    <span class="af-badge af-badge-green mb-3">@ViewData["UserRole"] account</span>
    <p class="af-muted mb-0">
        Your role workspace will load here once the dashboard modules are connected.
    </p>
</div>
