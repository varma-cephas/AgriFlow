@page
@model AgriFlow.Pages.Account.LoginModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
    ViewData["SidebarTitle"] = "Farm-to-business supply, traced from seed to sale.";
}

<div class="d-flex flex-column justify-content-center" style="min-height: calc(100vh - 6rem);">
    <div class="mx-auto w-100" style="max-width: 440px;">
        <h2 class="fw-bold mb-1">Welcome back</h2>
        <p class="text-muted small mb-4">Sign in to your AgriFlow workspace.</p>

        @if (TempData["SuccessMessage"] is string successMsg)
        {
            <div class="alert alert-success small">@successMsg</div>
        }

        @if (TempData["ResetError"] is string resetErr)
        {
            <div class="alert alert-danger small">@resetErr</div>
        }

        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

            <!-- Email address -->
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email address</label>
                <div class="input-group">
                    <span class="input-group-text border-end-0"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Input.Email" class="form-control border-start-0" placeholder="you@example.com" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <!-- Password with Show/Hide toggle -->
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Password</label>
                <div class="input-group">
                    <span class="input-group-text border-end-0"><i class="bi bi-lock"></i></span>
                    <input asp-for="Input.Password" id="passwordInput" type="password" class="form-control border-start-0 border-end-0" placeholder="Enter your password" />
                    <button type="button" id="togglePasswordBtn" class="input-group-text border-start-0 bg-white text-muted small fw-semibold" style="cursor: pointer;">
                        Show
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <!-- Keep me signed in & Forgot password -->
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="form-check m-0">
                    <input asp-for="Input.RememberMe" class="form-check-input" type="checkbox" />
                    <label asp-for="Input.RememberMe" class="form-check-label small">Keep me signed in</label>
                </div>
                <a href="#" class="small fw-semibold text-decoration-none" style="color: #1b653c;"
                   data-bs-toggle="modal" data-bs-target="#forgotPasswordModal">
                    Forgot password?
                </a>
            </div>

            <button type="submit" class="btn btn-agriflow w-100 mb-3">Sign in</button>

            <p class="text-center small text-muted mb-4">
                New to AgriFlow?
                <a asp-page="/Account/RegisterFarmer" class="fw-semibold text-decoration-none" style="color: #1b653c;">Create an account</a>
            </p>

            <!-- Agents and administrators callout -->
            <div class="callout-blue d-flex align-items-start gap-2">
                <i class="bi bi-info-circle fs-6 mt-1"></i>
                <div>
                    <div class="fw-semibold">Agents and administrators</div>
                    <div class="mt-1" style="opacity: 0.9;">
                        Your account is created by an AgriFlow administrator. Use the details they sent you.
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Reset Password Modal -->
<div class="modal fade" id="forgotPasswordModal" tabindex="-1" aria-labelledby="forgotPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content border-0 shadow rounded-4 p-2">
            <div class="modal-header border-0 pb-0 align-items-start">
                <div class="d-flex align-items-start gap-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width: 40px; height: 40px; background-color: #eef7f1; color: #1b653c;">
                        <i class="bi bi-envelope fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-1" id="forgotPasswordModalLabel">Reset your password</h5>
                        <p class="text-muted small mb-0">
                            Enter the email you signed up with. We'll send you a link to choose a new password.
                        </p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form method="post" asp-page-handler="ForgotPassword">
                <div class="modal-body pt-3">
                    <label asp-for="ResetEmail" class="form-label">Email address</label>
                    <div class="input-group">
                        <span class="input-group-text border-end-0"><i class="bi bi-envelope"></i></span>
                        <input asp-for="ResetEmail" type="email" class="form-control border-start-0" placeholder="jeanbosco@greenhills.example" required />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-agriflow px-3">Send reset link</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById("togglePasswordBtn")?.addEventListener("click", function () {
            const pwdInput = document.getElementById("passwordInput");
            const isHidden = pwdInput.type === "password";
            pwdInput.type = isHidden ? "text" : "password";
            this.textContent = isHidden ? "Hide" : "Show";
        });
    </script>
}