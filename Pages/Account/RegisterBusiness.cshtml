@page
@model AgriFlow.Pages.Account.RegisterBusinessModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Create Business Account";
}

<h2 class="fw-bold mb-1">Create your account</h2>
<p class="text-muted small mb-4">
    Already have one? <a asp-page="/Account/Login" class="text-success fw-semibold text-decoration-none">Sign in.</a>
</p>

<!-- Role Switcher -->
<div class="section-kicker">I AM A...</div>
<div class="row g-3 mb-4">
    <div class="col-sm-6">
        <a asp-page="/Account/RegisterFarmer" class="role-card">
            <div class="d-flex align-items-center gap-3">
                <div class="role-card-icon"><i class="bi bi-sprout"></i></div>
                <div>
                    <div class="fw-semibold small">Farmer</div>
                    <div class="text-muted" style="font-size: 0.78rem;">I grow and sell produce</div>
                </div>
            </div>
            <span class="role-radio"></span>
        </a>
    </div>
    <div class="col-sm-6">
        <a asp-page="/Account/RegisterBusiness" class="role-card active">
            <div class="d-flex align-items-center gap-3">
                <div class="role-card-icon"><i class="bi bi-building"></i></div>
                <div>
                    <div class="fw-semibold small">Business buyer</div>
                    <div class="text-muted" style="font-size: 0.78rem;">I buy produce in bulk</div>
                </div>
            </div>
            <span class="role-radio"></span>
        </a>
    </div>
</div>

<form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

    <!-- BUSINESS DETAILS -->
    <div class="section-kicker">BUSINESS DETAILS</div>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="Input.BusinessName" class="form-label">Business name <span class="required-star">*</span></label>
            <input asp-for="Input.BusinessName" class="form-control" placeholder="FreshMart Supermarkets" />
            <span asp-validation-for="Input.BusinessName" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.BusinessType" class="form-label">Business type <span class="required-star">*</span></label>
            <select asp-for="Input.BusinessType" class="form-select">
                <option value="">Select type...</option>
                <option value="Supermarket">Supermarket</option>
                <option value="Hotel">Hotel</option>
                <option value="Restaurant">Restaurant</option>
                <option value="School">School</option>
                <option value="Hospital">Hospital</option>
                <option value="Processor">Processor</option>
                <option value="Exporter">Exporter</option>
                <option value="Other">Other</option>
            </select>
            <span asp-validation-for="Input.BusinessType" class="text-danger small"></span>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="Input.RdbCompanyCode" class="form-label">RDB company code <span class="required-star">*</span></label>
            <input asp-for="Input.RdbCompanyCode" class="form-control" placeholder="108452367" />
            <div class="form-hint">From your RDB certificate.</div>
            <span asp-validation-for="Input.RdbCompanyCode" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.City" class="form-label">City <span class="required-star">*</span></label>
            <select asp-for="Input.City" class="form-select">
                <option value="">Select city...</option>
                <option value="Kigali">Kigali</option>
                <option value="Musanze">Musanze</option>
                <option value="Rubavu">Rubavu</option>
                <option value="Huye">Huye</option>
                <option value="Muhanga">Muhanga</option>
                <option value="Nyagatare">Nyagatare</option>
                <option value="Rwamagana">Rwamagana</option>
                <option value="Rusizi">Rusizi</option>
            </select>
            <span asp-validation-for="Input.City" class="text-danger small"></span>
        </div>
    </div>

    <div class="mb-4">
        <label asp-for="Input.Address" class="form-label">Business address <span class="required-star">*</span></label>
        <div class="input-group">
            <span class="input-group-text border-end-0"><i class="bi bi-geo-alt"></i></span>
            <input asp-for="Input.Address" class="form-control border-start-0" placeholder="Kimironko, Kigali" />
        </div>
        <span asp-validation-for="Input.Address" class="text-danger small"></span>
    </div>

    <!-- YOUR DETAILS -->
    <div class="section-kicker">YOUR DETAILS</div>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="Input.FullName" class="form-label">Full name <span class="required-star">*</span></label>
            <input asp-for="Input.FullName" class="form-control" placeholder="Aline Uwase" />
            <span asp-validation-for="Input.FullName" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.JobTitle" class="form-label">Role in business</label>
            <input asp-for="Input.JobTitle" class="form-control" placeholder="Procurement officer" />
            <span asp-validation-for="Input.JobTitle" class="text-danger small"></span>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="Input.Email" class="form-label">Work email <span class="required-star">*</span></label>
            <input asp-for="Input.Email" class="form-control" placeholder="aline.uwase@freshmart.example" />
            <span asp-validation-for="Input.Email" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Phone" class="form-label">Phone <span class="required-star">*</span></label>
            <input asp-for="Input.Phone" class="form-control" placeholder="078 555 0142" />
            <span asp-validation-for="Input.Phone" class="text-danger small"></span>
        </div>
    </div>

    <div class="mb-4">
        <label asp-for="Input.Password" class="form-label">Password <span class="required-star">*</span></label>
        <div class="input-group">
            <span class="input-group-text border-end-0"><i class="bi bi-lock"></i></span>
            <input asp-for="Input.Password" type="password" class="form-control border-start-0" placeholder="••••••••••" />
        </div>
        <div class="form-hint">At least 8 characters.</div>
        <span asp-validation-for="Input.Password" class="text-danger small"></span>
    </div>

    <!-- Blue Verification Info Callout -->
    <div class="callout-blue d-flex align-items-start gap-2 mb-4">
        <i class="bi bi-shield-check fs-6 mt-1"></i>
        <div>
            <div class="fw-semibold">Business accounts are verified before ordering</div>
            <div class="mt-1" style="opacity: 0.9;">
                We check your registration within 1 business day. You can browse the marketplace in the meantime.
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-agriflow w-100">Create business account</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}