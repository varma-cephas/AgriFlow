@page
@model AgriFlow.Pages.Account.PendingFarmerModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Farm Under Review";
}

<div class="d-flex flex-column justify-content-center" style="min-height: calc(100vh - 6rem);">
    <div class="mx-auto w-100" style="max-width: 500px;">
        <div class="status-hero-icon mb-3">
            <i class="bi bi-clock"></i>
        </div>

        <h2 class="fw-bold mb-2">We’re checking @Model.FarmName</h2>
        <p class="text-muted small mb-4">
            Thanks, @Model.FirstName. An administrator is checking your National ID and land UPI. This usually takes 1&ndash;2 days.
        </p>

        <!-- Timeline Card -->
        <div class="timeline-card mb-4">
            <div class="timeline-step">
                <div class="d-flex align-items-start gap-3">
                    <span class="step-dot done"><i class="bi bi-check-lg"></i></span>
                    <div>
                        <div class="fw-semibold small">Account created</div>
                        <div class="text-muted" style="font-size: 0.78rem;">@Model.CreatedAtText</div>
                    </div>
                </div>
            </div>

            <div class="timeline-step">
                <div class="d-flex align-items-start gap-3">
                    <span class="step-dot done"><i class="bi bi-check-lg"></i></span>
                    <div>
                        <div class="fw-semibold small">National ID and land UPI submitted</div>
                        <div class="text-muted" style="font-size: 0.78rem;">UPI @Model.LandUpi &middot; @Model.District</div>
                    </div>
                </div>
            </div>

            <div class="timeline-step">
                <div class="d-flex align-items-start gap-3">
                    <span class="step-dot current"><i class="bi bi-clock"></i></span>
                    <div>
                        <div class="fw-semibold small">Farm check</div>
                        <div class="text-muted" style="font-size: 0.78rem;">In progress &middot; usually 1&ndash;2 days</div>
                    </div>
                </div>
                <span class="badge-in-review">&bull; In review</span>
            </div>

            <div class="timeline-step">
                <div class="d-flex align-items-start gap-3">
                    <span class="step-dot upcoming"></span>
                    <div>
                        <div class="fw-semibold small text-muted">Listings visible to buyers</div>
                        <div class="text-muted" style="font-size: 0.78rem;">Your farm gets the Verified farm badge</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="row g-2 mb-3">
            <div class="col-sm-6">
                <a asp-page="/Farmer/Dashboard" class="btn btn-agriflow w-100">Go to my farm workspace</a>
            </div>
            <div class="col-sm-6">
                <a asp-page="/Farmer/EditProfile" class="btn btn-outline-secondary w-100 fw-semibold" style="padding: 0.7rem 1rem; border-radius: 8px;">
                    Edit farm details
                </a>
            </div>
        </div>

        <!-- Blue Info Callout -->
        <div class="callout-blue d-flex align-items-start gap-2">
            <i class="bi bi-info-circle fs-6 mt-1"></i>
            <div>
                <div class="fw-semibold">You can start now</div>
                <div class="mt-1" style="opacity: 0.9;">
                    Add seed stock and record plantings straight away. Buyers will see your listings once your farm is verified. Want it faster? Ask your farmer promoter or sector agronomist to visit.
                </div>
            </div>
        </div>
    </div>
</div>