@page
@model AgriFlow.Pages.Account.RegisterFarmerModel
@{
    Layout = User.IsInRole("Agent") ? "_AgentLayout" : "_AuthLayout";
    ViewData["Title"] = "Create Farmer Account";
}

<div class="agent-form-page">
<h2 class="fw-bold mb-1">@(User.IsInRole("Agent") ? "Register a farmer" : "Create your account")</h2>
<p class="text-muted small mb-4">
    @if (User.IsInRole("Agent"))
    {
        <span>Register a farmer on behalf of your assigned field area.</span>
    }
    else
    {
        <span>Already have one? <a asp-page="/Account/Login" class="text-success fw-semibold text-decoration-none">Sign in.</a></span>
    }
</p>

<!-- Role Switcher -->
@if (!User.IsInRole("Agent"))
{
<div class="section-kicker">I AM A...</div>
<div class="row g-3 mb-4">
    <div class="col-sm-6">
        <a asp-page="/Account/RegisterFarmer" class="role-card active">
            <div class="d-flex align-items-center gap-3">
                <div class="role-card-icon"><i class="bi bi-sprout"></i></div>
                <div>
                    <div class="fw-semibold small">Farmer</div>
                    <div class="text-muted" style="font-size: 0.78rem;">I grow and sell produce</div>
                </div>
            </div>
            <span class="role-radio"></span>
        </a>
    </div>
    <div class="col-sm-6">
        <a asp-page="/Account/RegisterBusiness" class="role-card">
            <div class="d-flex align-items-center gap-3">
                <div class="role-card-icon"><i class="bi bi-building"></i></div>
                <div>
                    <div class="fw-semibold small">Business buyer</div>
                    <div class="text-muted" style="font-size: 0.78rem;">I buy produce in bulk</div>
                </div>
            </div>
            <span class="role-radio"></span>
        </a>
    </div>
</div>
}

<form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

    <!-- YOUR DETAILS -->
    <div class="section-kicker">YOUR DETAILS</div>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="Input.FullName" class="form-label">Full name <span class="required-star">*</span></label>
            <input asp-for="Input.FullName" class="form-control" placeholder="Jean Bosco Habimana" />
            <span asp-validation-for="Input.FullName" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Phone" class="form-label">Phone <span class="required-star">*</span></label>
            <div class="input-group">
                <span class="input-group-text border-end-0"><i class="bi bi-telephone"></i></span>
                <input asp-for="Input.Phone" class="form-control border-start-0" placeholder="078 555 0198" />
            </div>
            <span asp-validation-for="Input.Phone" class="text-danger small"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">Email</label>
        <div class="input-group">
            <span class="input-group-text border-end-0"><i class="bi bi-envelope"></i></span>
            <input asp-for="Input.Email" class="form-control border-start-0" placeholder="jeanbosco@greenhills.example" />
        </div>
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Input.NationalId" class="form-label">National ID number <span class="required-star">*</span></label>
        <div class="input-group">
            <span class="input-group-text border-end-0"><i class="bi bi-person-vcard"></i></span>
            <input asp-for="Input.NationalId" class="form-control border-start-0" placeholder="1 1985 8 0123456 0 31" />
        </div>
        <div class="form-hint">16 digits. Used only to verify you &mdash; never shown to buyers.</div>
        <span asp-validation-for="Input.NationalId" class="text-danger small"></span>
    </div>

    <!-- YOUR FARM -->
    <div class="section-kicker">YOUR FARM</div>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="Input.FarmName" class="form-label">Farm name <span class="required-star">*</span></label>
            <input asp-for="Input.FarmName" class="form-control" placeholder="Green Hills Farm" />
            <span asp-validation-for="Input.FarmName" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Province" class="form-label">Province <span class="required-star">*</span></label>
            <select asp-for="Input.Province" id="provinceSelect" class="form-select">
                <option value="">Select province...</option>
            </select>
            <span asp-validation-for="Input.Province" class="text-danger small"></span>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="Input.District" class="form-label">District <span class="required-star">*</span></label>
            <select asp-for="Input.District" id="districtSelect" class="form-select">
                <option value="">Select district...</option>
            </select>
            <span asp-validation-for="Input.District" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Sector" class="form-label">Sector <span class="required-star">*</span></label>
            <select asp-for="Input.Sector" id="sectorSelect" class="form-select">
                <option value="">Select sector...</option>
            </select>
            <span asp-validation-for="Input.Sector" class="text-danger small"></span>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="Input.Cell" class="form-label">Cell <span class="required-star">*</span></label>
            <select asp-for="Input.Cell" id="cellSelect" class="form-select">
                <option value="">Select cell...</option>
            </select>
            <span asp-validation-for="Input.Cell" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Village" class="form-label">Village <span class="required-star">*</span></label>
            <input asp-for="Input.Village" class="form-control" placeholder="Ryabega" />
            <span asp-validation-for="Input.Village" class="text-danger small"></span>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="Input.LandUpi" class="form-label">Land UPI number <span class="required-star">*</span></label>
            <div class="input-group">
                <span class="input-group-text border-end-0"><i class="bi bi-grid-3x3"></i></span>
                <input asp-for="Input.LandUpi" class="form-control border-start-0" placeholder="3/03/10/04/1187" />
            </div>
            <div class="form-hint">From your land title or Smart Nkunganire registration.</div>
            <span asp-validation-for="Input.LandUpi" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.FarmSizeHa" class="form-label">Farm size</label>
            <div class="input-group">
                <input asp-for="Input.FarmSizeHa" type="number" step="0.01" class="form-control border-end-0" placeholder="3.5" />
                <span class="input-group-text border-start-0">ha</span>
            </div>
            <span asp-validation-for="Input.FarmSizeHa" class="text-danger small"></span>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="Input.MainCrops" class="form-label">Main crops <span class="required-star">*</span></label>
            <input asp-for="Input.MainCrops" class="form-control" placeholder="Maize, tomato, beans" />
            <span asp-validation-for="Input.MainCrops" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Cooperative" class="form-label">Cooperative (optional)</label>
            <input asp-for="Input.Cooperative" class="form-control" placeholder="Twitezimbere &middot; member 0918" />
            <span asp-validation-for="Input.Cooperative" class="text-danger small"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label">Password <span class="required-star">*</span></label>
        <div class="input-group">
            <span class="input-group-text border-end-0"><i class="bi bi-lock"></i></span>
            <input asp-for="Input.Password" type="password" class="form-control border-start-0" placeholder="••••••••••" />
        </div>
        <div class="form-hint">At least 8 characters.</div>
        <span asp-validation-for="Input.Password" class="text-danger small"></span>
    </div>

    <div class="form-check mb-4">
        <input asp-for="Input.AgreeToTerms" class="form-check-input" type="checkbox" />
        <label asp-for="Input.AgreeToTerms" class="form-check-label small">
            I agree to the <a href="#" class="text-success text-decoration-underline">Terms and Privacy Policy</a>
        </label>
        <div><span asp-validation-for="Input.AgreeToTerms" class="text-danger small"></span></div>
    </div>

    <button type="submit" class="btn btn-agriflow w-100 mb-3">@(User.IsInRole("Agent") ? "Register farmer" : "Create farmer account")</button>

    <!-- Bottom Green Info Callout -->
    <div class="callout-green d-flex align-items-start gap-2">
        <i class="bi bi-info-circle fs-6 mt-1"></i>
        <div>
            <div class="fw-semibold">Your farm is checked before buyers see your listings</div>
            <div class="mt-1" style="opacity: 0.9;">
                You can start recording straight away. Farms registered by a farmer promoter or sector agronomist are verified on the spot.
            </div>
        </div>
    </div>
</form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/rwanda-locations.js" asp-append-version="true"></script>
}