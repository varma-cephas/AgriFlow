@page
@model AgriFlow.Pages.Account.PendingBusinessModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Business Verification Pending";
    ViewData["SidebarTitle"] = "Reliable bulk supply, direct from verified farms.";
}

<div class="d-flex flex-column justify-content-center" style="min-height: calc(100vh - 6rem);">
    <div class="mx-auto w-100" style="max-width: 500px;">
        <div class="status-hero-icon mb-3">
            <i class="bi bi-clock"></i>
        </div>

        <h2 class="fw-bold mb-2">We’re verifying @Model.BusinessName</h2>
        <p class="text-muted small mb-4">
            Thanks, @Model.FirstName. An administrator is checking your business registration. This usually takes less than one business day.
        </p>

        <!-- Timeline Card -->
        <div class="timeline-card mb-4">
            <div class="timeline-step">
                <div class="d-flex align-items-start gap-3">
                    <span class="step-dot done"><i class="bi bi-check-lg"></i></span>
                    <div>
                        <div class="fw-semibold small">Account created</div>
                        <div class="text-muted" style="font-size: 0.78rem;">@Model.CreatedAtText</div>
                    </div>
                </div>
            </div>

            <div class="timeline-step">
                <div class="d-flex align-items-start gap-3">
                    <span class="step-dot done"><i class="bi bi-check-lg"></i></span>
                    <div>
                        <div class="fw-semibold small">Business details submitted</div>
                        <div class="text-muted" style="font-size: 0.78rem;">Registration @Model.RdbCompanyCode</div>
                    </div>
                </div>
            </div>

            <div class="timeline-step">
                <div class="d-flex align-items-start gap-3">
                    <span class="step-dot current"><i class="bi bi-clock"></i></span>
                    <div>
                        <div class="fw-semibold small">Admin review</div>
                        <div class="text-muted" style="font-size: 0.78rem;">In progress &middot; usually under 1 day</div>
                    </div>
                </div>
                <span class="badge-in-review">&bull; In review</span>
            </div>

            <div class="timeline-step">
                <div class="d-flex align-items-start gap-3">
                    <span class="step-dot upcoming"></span>
                    <div>
                        <div class="fw-semibold small text-muted">Ready to reserve and order</div>
                        <div class="text-muted" style="font-size: 0.78rem;">We'll email @Model.Email</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="row g-2 mb-3">
            <div class="col-sm-6">
                <a asp-page="/Buyer/Dashboard" class="btn btn-agriflow w-100">Browse marketplace</a>
            </div>
            <div class="col-sm-6">
                <a asp-page="/Buyer/EditProfile" class="btn btn-outline-secondary w-100 fw-semibold" style="padding: 0.7rem 1rem; border-radius: 8px;">
                    Edit business details
                </a>
            </div>
        </div>

        <p class="text-muted" style="font-size: 0.78rem;">
            You can browse listings now. Reserving and ordering unlock as soon as your business is verified. Questions? support@agriflow.example
        </p>
    </div>
</div>