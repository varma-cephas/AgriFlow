@page
@model AgriFlow.Pages.SeedStock.AddModel
@{
    ViewData["Title"] = "Add seed stock";
}

<h1 class="h3 mb-3">Add seed stock</h1>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-secondary">@Model.StatusMessage</div>
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Input.CropId" class="form-label">Crop</label>
        <select asp-for="Input.CropId" class="form-select">
            <option value="">Select a crop</option>
            @foreach (var crop in Model.Crops)
            {
                <option value="@crop.Id">@crop.Name</option>
            }
        </select>
        <span asp-validation-for="Input.CropId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Variety" class="form-label">Variety</label>
        <input asp-for="Input.Variety" class="form-control" maxlength="80" />
        <span asp-validation-for="Input.Variety" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Quantity" class="form-label">Quantity</label>
        <input asp-for="Input.Quantity" class="form-control" type="number" min="0" step="0.01" />
        <span asp-validation-for="Input.Quantity" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Unit" class="form-label">Unit</label>
        <input asp-for="Input.Unit" class="form-control" maxlength="10" />
        <span asp-validation-for="Input.Unit" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Supplier" class="form-label">Supplier (optional)</label>
        <input asp-for="Input.Supplier" class="form-control" maxlength="120" />
        <span asp-validation-for="Input.Supplier" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save seed stock</button>
    <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
