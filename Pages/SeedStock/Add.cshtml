@page
@model AgriFlow.Pages.SeedStock.AddModel
@{
    ViewData["Title"] = "Add Seed Stock";
}

<div class="mb-4">
    <a asp-page="/PlantingBatches/Create" asp-route-farmId="@Model.FarmId" class="text-decoration-none small text-muted"><i class="bi bi-arrow-left me-1"></i>Back to recording planting</a>
    <h2 class="fw-bold mt-2 mb-1">Add seed stock</h2>
    <p class="text-muted mb-0">Add seed to your farm's inventory before recording a planting.</p>
</div>

@if (Model.Farms.Count == 0)
{
    <div class="alert alert-info">No farm is currently linked to your account. Ask an administrator to assign your farm before adding seed stock.</div>
}
else
{
    @if (Model.Farms.Count > 1)
    {
        <form method="get" class="card border-0 shadow-sm mb-3">
            <div class="card-body d-flex align-items-center gap-3">
                <label for="FarmId" class="form-label fw-semibold mb-0">Farm</label>
                <select id="FarmId" name="FarmId" class="form-select" onchange="this.form.submit()">
                    @foreach (var farm in Model.Farms)
                    {
                        <option value="@farm.Id" selected="@(farm.Id == Model.FarmId)">@farm.Name</option>
                    }
                </select>
            </div>
        </form>
    }
    @if (!string.IsNullOrWhiteSpace(Model.PageError))
    {
        <div class="alert alert-danger">@Model.PageError</div>
    }
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="card border-0 shadow-sm" style="max-width: 720px;">
        <div class="card-body p-4">
            <form method="post">
                <input type="hidden" asp-for="FarmId" />
                <div class="mb-3">
                    <label asp-for="Input.CropId" class="form-label fw-semibold">Crop</label>
                    <select asp-for="Input.CropId" class="form-select" required>
                        <option value="0">Choose a crop</option>
                        @foreach (var crop in Model.Crops)
                        {
                            <option value="@crop.Id">@crop.Name · @crop.MaturityDays days to maturity</option>
                        }
                    </select>
                    <span asp-validation-for="Input.CropId" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Variety" class="form-label fw-semibold">Variety</label>
                    <input asp-for="Input.Variety" class="form-control" maxlength="80" placeholder="e.g. Roma" required />
                    <span asp-validation-for="Input.Variety" class="text-danger small"></span>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Input.Quantity" class="form-label fw-semibold">Quantity added</label>
                        <div class="input-group">
                            <input asp-for="Input.Quantity" class="form-control" type="number" min="0.01" step="0.01" required />
                            <span class="input-group-text">kg</span>
                        </div>
                        <span asp-validation-for="Input.Quantity" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.Supplier" class="form-label fw-semibold">Supplier <span class="text-muted fw-normal">(optional)</span></label>
                        <input asp-for="Input.Supplier" class="form-control" maxlength="120" />
                        <span asp-validation-for="Input.Supplier" class="text-danger small"></span>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-page="/PlantingBatches/Create" asp-route-farmId="@Model.FarmId" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-success"><i class="bi bi-plus-lg me-1"></i>Add seed stock</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
