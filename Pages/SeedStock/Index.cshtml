@page
@model AgriFlow.Pages.SeedStock.IndexModel

@{
    ViewData["Title"] = "Seed stock";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Seed stock</h1>
 feature/AGRI-17-low-stock-warnings
        <p class="text-muted mb-0">Inventory items at or below 10 are marked low stock.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white">
            <thead>
                <tr>
                    @if (User.IsInRole("Agent") || User.IsInRole("Admin"))
                    {
                        <th scope="col">Farm</th>
                    }
                    <th scope="col">Crop</th>
                    <th scope="col">Variety</th>
                    <th scope="col">Available quantity</th>
                    <th scope="col">Last updated</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        @if (User.IsInRole("Agent") || User.IsInRole("Admin"))
                        {
                            <td>@item.FarmName</td>
                        }
                        <td>@item.CropName</td>
                        <td>@item.Variety</td>
                        <td>
                            @item.Quantity.ToString("0.##") @item.Unit
                            @if (item.Quantity <= SeedStockRepository.LowStockThreshold)
                            {
                                <span class="badge bg-danger">Low stock</span>
                            }
                        </td>
                        <td>@item.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="@(User.IsInRole("Agent") || User.IsInRole("Admin") ? 5 : 4)" class="text-center text-muted py-4">
                            No seed stock found in your authorized inventory scope.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

        <div class="text-muted">Active farmer/farm: @Model.ActiveFarmerName</div>
    </div>
    @if (Model.ActiveFarmerId.HasValue)
    {
        <a class="btn btn-primary" asp-page="./Add">Add seed stock</a>
    }
</div>

@if (Model.IsAgent)
{
    <div class="alert alert-info">Agent view: acting on behalf of an assigned farmer.</div>
    @if (Model.AssignedFarmers.Count > 0)
    {
        <form method="get" class="row g-2 align-items-end mb-3">
            <div class="col-auto">
                <label for="farmerId" class="form-label">Assigned farmer</label>
                <select id="farmerId" name="farmerId" class="form-select">
                    @foreach (var farmer in Model.AssignedFarmers)
                    {
                        <option value="@farmer.Id" selected="@(Model.ActiveFarmerId == farmer.Id)">@farmer.Name</option>
                    }
                </select>
            </div>
            <div class="col-auto"><button type="submit" class="btn btn-outline-primary">View farmer</button></div>
        </form>
    }
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-secondary">@Model.StatusMessage</div>
}

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Crop</th>
                <th>Available quantity</th>
                <th>Maturity</th>
                <th>Supplier</th>
                <th>Last updated</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.StockRows)
        {
            <tr>
                <td><strong>@row.CropName</strong><br /><span class="text-muted">@row.Variety</span></td>
                <td>@row.Quantity.ToString("0.##") @row.Unit</td>
                <td>@row.MaturityDays days</td>
                <td>@(string.IsNullOrWhiteSpace(row.Supplier) ? "—" : row.Supplier)</td>
                <td>@row.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@row.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    @if (Model.CanDelete)
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal" data-bs-target="#deleteSeedStockModal"
                                data-seed-stock-id="@row.Id"
                                data-seed-stock-name="@row.CropName — @row.Variety">
                            Delete
                        </button>
                    }
                </td>
            </tr>
        }
        @if (!Model.StockRows.Any())
        {
            <tr><td colspan="6" class="text-center text-muted">No seed stock found.</td></tr>
        }
        </tbody>
    </table>
</div>

@if (Model.CanDelete)
{
    <div class="modal fade" id="deleteSeedStockModal" tabindex="-1" aria-labelledby="deleteSeedStockModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page-handler="Delete">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="deleteSeedStockModalLabel">Delete seed stock?</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to delete <strong id="deleteSeedStockName"></strong>?</p>
                        <p class="mb-0">This action cannot be undone.</p>
                        <input type="hidden" name="id" id="deleteSeedStockId" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        const deleteSeedStockModal = document.getElementById('deleteSeedStockModal');
        if (deleteSeedStockModal) {
            deleteSeedStockModal.addEventListener('show.bs.modal', event => {
                const button = event.relatedTarget;
                document.getElementById('deleteSeedStockId').value = button.getAttribute('data-seed-stock-id');
                document.getElementById('deleteSeedStockName').textContent = button.getAttribute('data-seed-stock-name');
            });
        }
    </script>
}

