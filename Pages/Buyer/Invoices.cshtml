@page
@model AgriFlow.Pages.Buyer.InvoicesModel
@{ Layout = "_BuyerLayout"; ViewData["Title"] = "Invoices"; }
<div class="buyer-page">
    <div class="buyer-heading"><div><div class="buyer-eyebrow">PAYMENTS</div><h1>Invoices</h1><p>Invoices are created after the farmer marks an order delivered.</p></div></div>
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success small">@success</div> }
    @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger small">@error</div> }
    <div class="row g-3 mb-4"><div class="col-md-3"><div class="buyer-mini-stat"><span>Unpaid</span><strong>@Model.Invoices.Count(x => x.Status == "Unpaid")</strong><small>Ready for payment</small></div></div><div class="col-md-3"><div class="buyer-mini-stat"><span>Paid</span><strong>@Model.Invoices.Count(x => x.Status == "Paid")</strong><small>Payment records</small></div></div><div class="col-md-3"><div class="buyer-mini-stat"><span>Total invoices</span><strong>@Model.Invoices.Count</strong><small>Accepted orders</small></div></div><div class="col-md-3"><div class="buyer-mini-stat"><span>Overdue</span><strong>0</strong><small>Nothing overdue</small></div></div></div>
    <div class="buyer-card">
        @if (!Model.Invoices.Any()) { <div class="buyer-empty"><i class="bi bi-file-earmark-text"></i><h3>No invoices yet</h3><p>Invoices will be generated after a farmer marks an order delivered.</p></div> }
        else { <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Invoice</th><th>Produce</th><th>Quantity</th><th>Amount</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var item in Model.Invoices) { <tr><td><strong>@item.InvoiceNumber</strong><small class="d-block text-muted">@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small></td><td>@item.CropName</td><td>@item.Quantity.ToString("0.##") @item.Unit</td><td><strong>RWF @item.TotalAmount.ToString("N0")</strong></td><td><span class="badge bg-light text-dark">@item.Status</span></td><td>@if (item.Status == "Unpaid") { <form method="post" asp-page-handler="Pay"><input type="hidden" name="orderId" value="@item.OrderId" /><button class="buyer-primary-button" type="submit">Pay now</button></form> } else { <span class="text-muted small">Receipt available</span> }</td></tr> }</tbody></table></div> }
    </div>
    <div class="buyer-info-note"><i class="bi bi-info-circle"></i><span>Payments are simulated in this release. No money moves through AgriFlow.</span></div>
</div>
