@page
@model AgriFlow.Pages.Buyer.EditProfileModel
@{
    ViewData["Title"] = "Edit Business Details";
}

<div class="card border-0 shadow-sm" style="max-width: 640px;">
    <div class="card-body p-4">
        <h4 class="fw-bold mb-1">Edit Business Details</h4>
        <p class="text-muted small mb-4">Update your business address, contact phone, or RDB registration details.</p>

        <div class="alert alert-info small mb-4">
            <i class="bi bi-tools me-1"></i> Business profile editing form will be implemented here next.
        </div>

        <a asp-page="/Buyer/Dashboard" class="btn btn-outline-secondary btn-sm">Back to Marketplace</a>
    </div>
</div>