@page
@model AgriFlow.Pages.Buyer.DashboardModel
@{
    ViewData["Title"] = "Marketplace & Buyer Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Produce Marketplace</h3>
        <p class="text-muted small mb-0">Welcome, @User.Identity?.Name. Browse upcoming harvests and verified farm supply.</p>
    </div>
    <a asp-page="/Buyer/EditProfile" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-building me-1"></i> Edit business details
    </a>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold text-uppercase mb-1">Available Listings</div>
                <h4 class="fw-bold mb-1">0 listings</h4>
                <p class="text-muted small mb-0">Harvested produce ready for immediate bulk order.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold text-uppercase mb-1">Active Reservations</div>
                <h4 class="fw-bold mb-1">0 reserved</h4>
                <p class="text-muted small mb-0">Upcoming crops reserved prior to harvest.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold text-uppercase mb-1">Unpaid Invoices</div>
                <h4 class="fw-bold mb-1">0 RWF</h4>
                <p class="text-muted small mb-0">Invoices generated from accepted deliveries.</p>
            </div>
        </div>
    </div>
</div>