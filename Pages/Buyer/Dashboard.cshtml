@page
@model AgriFlow.Pages.Buyer.DashboardModel
@{
    Layout = "_BuyerLayout";
    ViewData["Title"] = "Overview";
}

<div class="buyer-page">
    <div class="buyer-heading">
        <div><div class="buyer-eyebrow">BUYER WORKSPACE</div><h1>Good morning, @User.Identity?.Name?.Split(' ').FirstOrDefault()</h1><p>Source reliable produce from verified farms across Rwanda.</p></div>
        <a asp-page="/Buyer/EditProfile" class="buyer-outline-button"><i class="bi bi-building me-2"></i>Business profile</a>
    </div>
    <div class="buyer-alert"><i class="bi bi-shield-check"></i><div><strong>Verified supply, clearer buying.</strong><span>Every farmer listing is connected to a traceable farm record.</span></div></div>
    <div class="row g-3 mb-4">
        <div class="col-md-4"><a asp-page="/Buyer/Marketplace" class="buyer-stat-link"><div class="buyer-stat"><div class="buyer-stat-icon green"><i class="bi bi-shop"></i></div><div><span>Available listings</span><strong>@Model.ActiveListings</strong><small>Produce ready for bulk order</small></div></div></a></div>
        <div class="col-md-4"><a asp-page="/Buyer/Orders" class="buyer-stat-link"><div class="buyer-stat"><div class="buyer-stat-icon purple"><i class="bi bi-box-seam"></i></div><div><span>Active orders</span><strong>0</strong><small>Track confirmations and delivery</small></div></div></a></div>
        <div class="col-md-4"><a asp-page="/Buyer/Invoices" class="buyer-stat-link"><div class="buyer-stat"><div class="buyer-stat-icon amber"><i class="bi bi-receipt"></i></div><div><span>Unpaid invoices</span><strong>0 RWF</strong><small>Invoices from accepted deliveries</small></div></div></a></div>
    </div>
    <div class="row g-4">
        <div class="col-lg-8"><div class="buyer-card"><div class="buyer-card-header"><div><h2>Explore the marketplace</h2><p>Fresh listings from farmers currently available.</p></div><a asp-page="/Buyer/Marketplace" class="buyer-link">View all <i class="bi bi-arrow-right"></i></a></div>
        @if (!Model.Listings.Any()) { <div class="buyer-empty"><i class="bi bi-shop"></i><h3>No listings available yet</h3><p>New produce will appear here as verified farmers publish listings.</p></div> }
        else { <div class="buyer-list">@foreach (var listing in Model.Listings.Take(4)) { <div class="buyer-list-row"><div class="buyer-crop-icon">@listing.CropName.Substring(0, 1).ToUpperInvariant()</div><div class="buyer-list-main"><strong>@listing.CropName</strong><span>@listing.FarmName · @listing.FarmerName</span></div><div class="buyer-list-price"><strong>RWF @listing.PricePerUnit.ToString("N0")</strong><span>/ @listing.Unit</span></div><a asp-page="/Buyer/Marketplace" class="buyer-small-button">View</a></div>}</div> }</div></div>
        <div class="col-lg-4"><div class="buyer-card buyer-quick-card"><div class="buyer-card-header"><div><h2>Quick actions</h2><p>Keep your procurement moving.</p></div></div><a asp-page="/Buyer/Marketplace" class="buyer-action"><i class="bi bi-search"></i><span><strong>Find produce</strong><small>Browse active farm listings</small></span><i class="bi bi-chevron-right"></i></a><a asp-page="/Buyer/Orders" class="buyer-action"><i class="bi bi-truck"></i><span><strong>Track orders</strong><small>See confirmations and delivery</small></span><i class="bi bi-chevron-right"></i></a><a asp-page="/Buyer/Invoices" class="buyer-action"><i class="bi bi-file-earmark-text"></i><span><strong>Review invoices</strong><small>Payments and receipts</small></span><i class="bi bi-chevron-right"></i></a></div></div>
    </div>
</div>