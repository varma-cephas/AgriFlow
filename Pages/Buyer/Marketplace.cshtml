@page
@model AgriFlow.Pages.Buyer.MarketplaceModel
@{ Layout = "_BuyerLayout"; ViewData["Title"] = "Marketplace"; }
<div class="buyer-page">
    <div class="buyer-heading"><div><div class="buyer-eyebrow">FARM SUPPLY</div><h1>Marketplace</h1><p>Browse active produce listings from verified farmers.</p></div><span class="buyer-count-badge"><i class="bi bi-shop"></i> @Model.Listings.Count listings</span></div>
    @if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="alert alert-danger small">@Model.Error</div> }
    @if (!Model.Listings.Any()) { <div class="buyer-card buyer-empty"><i class="bi bi-shop"></i><h3>No listings available</h3><p>Active farmer listings will appear here when produce is published.</p></div> }
    else { <div class="row g-4">@foreach (var item in Model.Listings) { <div class="col-md-6 col-xl-4"><article class="buyer-product"><div class="buyer-product-icon">@item.CropName.Substring(0, 1).ToUpperInvariant()</div><div class="buyer-product-body"><div class="d-flex justify-content-between gap-2"><h2>@item.CropName</h2><span class="buyer-open-pill">Open</span></div><p class="buyer-product-farmer"><i class="bi bi-person"></i> @item.FarmerName<br /><i class="bi bi-geo-alt"></i> @item.FarmName</p><div class="buyer-product-price">RWF @item.PricePerUnit.ToString("N0") <small>/ @item.Unit</small></div><div class="buyer-product-quantity"><span>Available</span><strong>@item.AvailableQuantity.ToString("0.##") @item.Unit</strong></div><form method="post" asp-page-handler="Order"><input type="hidden" name="ListingId" value="@item.Id" /><label class="form-label small fw-semibold mb-1">Quantity (@item.Unit)</label><div class="input-group mb-2"><input class="form-control" type="number" name="Quantity" min="0.01" max="@item.AvailableQuantity" step="0.01" required placeholder="Enter quantity" /><button class="buyer-primary-button" type="submit"><i class="bi bi-cart-plus me-1"></i> Order</button></div></form></div></article></div> }</div> }
</div>
