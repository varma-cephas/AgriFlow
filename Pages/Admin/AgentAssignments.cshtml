@page
@model AgriFlow.Pages.Admin.AgentAssignmentsModel
@{ Layout="_AdminLayout"; ViewData["Title"]="Agent Assignments"; ViewData["Section"]="Agent assignments"; }
<div class="admin-page"><div class="admin-heading"><div><div class="admin-eyebrow">ADMINISTRATION / AGENT ASSIGNMENTS</div><h1>Agent assignments</h1><p>Agents can only act for farmers assigned to them. Assign farmers by area.</p></div><button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#assignModal"><i class="bi bi-plus-lg me-1"></i> Assign farmers</button></div><div class="row g-3"><div class="col-md-3"><div class="admin-stat"><i class="bi bi-link-45deg"></i><strong>@Model.Farmers.Count(f => f.AgentName != null)</strong><span>Assigned farmers</span><small>Of @Model.Farmers.Count farmers</small></div></div><div class="col-md-3"><div class="admin-stat"><i class="bi bi-exclamation-triangle"></i><strong>@Model.Farmers.Count(f => f.AgentName == null)</strong><span>Without an agent</span><small>Need assignment</small></div></div><div class="col-md-3"><div class="admin-stat"><i class="bi bi-people"></i><strong>@Model.Agents.Count</strong><span>Active agents</span><small>Registered agents</small></div></div><div class="col-md-3"><div class="admin-stat"><i class="bi bi-person-check"></i><strong>@(Model.Agents.Count == 0 ? 0 : (double)Model.Farmers.Count(f => f.AgentName != null) / Model.Agents.Count)</strong><span>Farmers per agent</span><small>On average</small></div></div></div><div class="admin-card mt-4"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Agent</th><th>District</th><th>Assigned farmers</th><th>Action</th></tr></thead><tbody>@foreach (var agent in Model.Agents) { <tr><td><strong>@agent.Name</strong><br /><small class="text-muted">@agent.Email</small></td><td>@agent.District</td><td>@agent.FarmerCount farmers</td><td><button class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#assignModal" data-agent="@agent.Id">Manage farmers</button></td></tr>}</tbody></table></div></div></div>
<div class="modal fade" id="assignModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" asp-page-handler="Assign"><div class="modal-header"><h5 class="modal-title"><i class="bi bi-link-45deg text-success me-2"></i>Assign farmers</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">Agent</label><select asp-for="SelectedAgentId" class="form-select mb-3"><option value="">Select agent...</option>@foreach (var agent in Model.Agents) {<option value="@agent.Id">@agent.Name</option>}</select><label class="form-label">Farmers</label>@foreach (var farmer in Model.Farmers) {<div class="form-check border rounded p-2 mb-2"><input class="form-check-input ms-1" type="checkbox" name="SelectedFarmerIds" value="@farmer.Id" id="farmer-@farmer.Id" /><label class="form-check-label ms-2" for="farmer-@farmer.Id"><strong>@farmer.Name</strong><br /><small>@farmer.FarmName · @farmer.District · @(farmer.AgentName ?? "no agent")</small></label></div>}</div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-success">Assign selected</button></div></form></div></div></div>
