@page
@model AgriFlow.Pages.Admin.DashboardModel
@{ Layout="_AdminLayout"; ViewData["Title"]="Administration Overview"; ViewData["Section"]="Overview"; }
<div class="admin-page"><div class="admin-heading"><div><div class="admin-eyebrow">ADMINISTRATION</div><h1>Overview</h1><p>Monitor AgriFlow activity, approvals, and marketplace operations.</p></div></div><div class="row g-3"><div class="col-md-3"><div class="admin-stat"><i class="bi bi-people"></i><strong>@Model.Stats.Farmers</strong><span>Farmers</span><small>@Model.Stats.PendingFarmers pending verification</small></div></div><div class="col-md-3"><div class="admin-stat"><i class="bi bi-building"></i><strong>@Model.Stats.Businesses</strong><span>Buyer businesses</span><small>@Model.Stats.PendingBusinesses pending review</small></div></div><div class="col-md-3"><div class="admin-stat"><i class="bi bi-person-badge"></i><strong>@Model.Stats.Agents</strong><span>Active agents</span><small>@Model.Stats.AssignedFarmers farmers assigned</small></div></div><div class="col-md-3"><div class="admin-stat"><i class="bi bi-bag-check"></i><strong>@Model.Stats.Orders</strong><span>Orders</span><small>Marketplace orders</small></div></div></div><div class="admin-card mt-4"><h5>Administration actions</h5><p>Review and manage the platform from the workspace.</p><div class="row g-3"><div class="col-md-4"><a class="admin-action" asp-page="/Admin/Verification"><i class="bi bi-shield-check"></i><strong>Review verification</strong><small>Approve farmers and businesses</small></a></div><div class="col-md-4"><a class="admin-action" asp-page="/Admin/AgentAssignments"><i class="bi bi-link-45deg"></i><strong>Assign farmers</strong><small>Connect farmers with agents</small></a></div><div class="col-md-4"><a class="admin-action" asp-page="/Admin/Orders"><i class="bi bi-cart-check"></i><strong>Orders and disputes</strong><small>Monitor marketplace activity</small></a></div></div></div></div>