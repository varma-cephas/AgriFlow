@page
@model AgriFlow.Pages.Admin.ModerationModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Moderation"; ViewData["Section"] = "Moderation"; }
<div class="admin-page">
    <div class="admin-heading"><div><div class="admin-eyebrow">PLATFORM SAFETY</div><h1>Moderation</h1><p>Review accounts, reports, and activity that needs administrator attention.</p></div></div>
    <div class="row g-4">
        <div class="col-lg-6"><div class="admin-card h-100"><div class="admin-card-header"><div><h3>Pending farmers</h3><span>@Model.Farmers.Count registration(s) waiting for review</span></div><i class="bi bi-person-check admin-card-icon"></i></div>@if (!Model.Farmers.Any()) { <div class="admin-empty"><i class="bi bi-check-circle"></i><h5>Nothing to review</h5><p>All farmer registrations are up to date.</p></div> } else { <div class="table-responsive"><table class="table admin-table"><thead><tr><th>Applicant</th><th>Farm</th><th>Status</th></tr></thead><tbody>@foreach (var item in Model.Farmers) { <tr><td><strong>@item.Name</strong><small>@item.Email</small></td><td>@item.FarmName<small>@item.District</small></td><td><span class="badge bg-warning-subtle text-warning-emphasis">@item.Status</span></td></tr>}</tbody></table></div><a asp-page="/Admin/Verification" class="btn btn-success btn-sm">Open verification</a> }</div></div>
        <div class="col-lg-6"><div class="admin-card h-100"><div class="admin-card-header"><div><h3>Pending businesses</h3><span>@Model.Businesses.Count business review(s) waiting</span></div><i class="bi bi-building-check admin-card-icon"></i></div>@if (!Model.Businesses.Any()) { <div class="admin-empty"><i class="bi bi-check-circle"></i><h5>Nothing to review</h5><p>All buyer businesses are up to date.</p></div> } else { <div class="table-responsive"><table class="table admin-table"><thead><tr><th>Business</th><th>Contact</th><th>Status</th></tr></thead><tbody>@foreach (var item in Model.Businesses) { <tr><td><strong>@item.Name</strong><small>@item.RdbCode</small></td><td>@item.ContactName<small>@item.Email</small></td><td><span class="badge bg-warning-subtle text-warning-emphasis">@item.Status</span></td></tr>}</tbody></table></div><a asp-page="/Admin/Verification" class="btn btn-success btn-sm">Open verification</a> }</div></div>
    </div>
</div>
