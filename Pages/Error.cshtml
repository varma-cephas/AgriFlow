@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="mb-3 text-danger">
            <i class="bi bi-exclamation-circle" style="font-size: 3rem;"></i>
        </div>
        <h2 class="fw-bold mb-2">Something went wrong</h2>
        <p class="text-muted mb-4">
            We couldn't complete your request right now. Please try again or return to your dashboard.
        </p>

        @if (Model.ShowRequestId)
        {
            <p class="small text-muted mb-4">
                Reference ID: <code>@Model.RequestId</code>
            </p>
        }

        <a asp-page="/Index" class="btn px-4 text-white fw-semibold" style="background-color: #1b653c;">
            Back to AgriFlow
        </a>
    </div>
</div>