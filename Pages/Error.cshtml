@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
    ViewData["Breadcrumb"] = "Workspace / Error";
}

<div class="af-card text-center mx-auto" style="max-width: 520px;">
    <div class="af-icon-tile af-tile-red mx-auto mb-3"><i class="bi bi-exclamation-circle"></i></div>
    <h2 class="mb-2" style="font-size: 20px;">Something went wrong</h2>
    <p class="af-muted mb-4">
        We couldn't complete your request right now. Please try again or return to your dashboard.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="small af-muted mb-4">
            Reference ID: <code>@Model.RequestId</code>
        </p>
    }

    <a asp-page="/Index" class="af-btn af-btn-primary">Back to AgriFlow</a>
</div>
