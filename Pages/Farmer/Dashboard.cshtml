@page
@model AgriFlow.Pages.Farmer.DashboardModel
@{
    ViewData["Title"] = "Farm Workspace";
    ViewData["Breadcrumb"] = "Farmer workspace / Overview";
    Func<dynamic, object> actions = @<a asp-page="/Farmer/EditFarmer" class="af-btn af-btn-secondary"><i class="bi bi-pencil"></i> Edit farm details</a>;
}

<partial name="_PageHeader" model='new PageHeaderModel {
    Icon = "bi-house-door",
    Title = "Farm Workspace",
    Subtitle = "Welcome back, " + User.Identity?.Name + ". Manage your seeds, plantings, and harvests.",
    Actions = actions }' />

<div class="row g-3">
    <div class="col-md-4">
        <div class="af-card af-kpi">
            <div class="af-icon-tile"><i class="bi bi-box-seam"></i></div>
            <div>
                <div class="kpi-label">Seed stock</div>
                <div class="kpi-value">0 items</div>
                <div class="kpi-sub">Track available seeds and low-stock alerts.</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="af-card af-kpi">
            <div class="af-icon-tile af-tile-blue"><i class="bi bi-flower2"></i></div>
            <div>
                <div class="kpi-label">Active plantings</div>
                <div class="kpi-value">0 batches</div>
                <div class="kpi-sub">Monitor crop maturity and predicted harvest dates.</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="af-card af-kpi">
            <div class="af-icon-tile af-tile-purple"><i class="bi bi-truck"></i></div>
            <div>
                <div class="kpi-label">Buyer orders</div>
                <div class="kpi-value">0 orders</div>
                <div class="kpi-sub">Confirm reservations and dispatch harvested produce.</div>
            </div>
        </div>
    </div>
</div>
