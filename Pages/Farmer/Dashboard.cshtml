@page
@model AgriFlow.Pages.Farmer.DashboardModel
@{
    ViewData["Title"] = "Farm Workspace";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Farm Workspace</h3>
        <p class="text-muted small mb-0">Welcome back, @User.Identity?.Name. Manage your seeds, plantings, and harvests.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/PlantingBatches/Create" class="btn btn-success btn-sm">
            <i class="bi bi-plus-circle me-1"></i> Record planting
        </a>
        <a asp-page="/Farmer/EditProfile" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit farm details
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold text-uppercase mb-1">Seed Stock</div>
                <h4 class="fw-bold mb-1">0 items</h4>
                <p class="text-muted small mb-0">Track available seeds and low-stock alerts.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold text-uppercase mb-1">Active Plantings</div>
                <h4 class="fw-bold mb-1">0 batches</h4>
                <p class="text-muted small mb-0">Monitor crop maturity and predicted harvest dates.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small fw-semibold text-uppercase mb-1">Buyer Orders</div>
                <h4 class="fw-bold mb-1">0 orders</h4>
                <p class="text-muted small mb-0">Confirm reservations and dispatch harvested produce.</p>
            </div>
        </div>
    </div>
</div>