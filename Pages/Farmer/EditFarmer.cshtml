@page
@model AgriFlow.Pages.Farmer.EditProfileModel
@{
    ViewData["Title"] = "Edit Farm Details";
    ViewData["Breadcrumb"] = "Farmer workspace / Edit farm details";
}

<partial name="_PageHeader" model='new PageHeaderModel {
    Icon = "bi-pencil",
    Title = "Edit Farm Details",
    Subtitle = "Update your farm name, location, or cooperative information." }' />

<div class="af-card" style="max-width: 640px;">
    <div class="alert alert-info small mb-4">
        <i class="bi bi-tools me-1"></i> Farm profile editing form will be implemented here next.
    </div>

    <a asp-page="/Farmer/Dashboard" class="af-btn af-btn-secondary">Back to Farm Workspace</a>
</div>
