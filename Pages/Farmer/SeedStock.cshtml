@page
@model AgriFlow.Pages.Farmer.SeedStockModel
@{ Layout="_FarmerLayout"; ViewData["Title"]="Seed stock"; }
<div class="farmer-page"><div class="farmer-heading"><div><div class="farmer-eyebrow">FARM PRODUCTION</div><h1>Seed stock</h1><p>Keep your available seed quantities up to date before recording planting.</p></div></div>
@if (TempData["Success"] is string message) { <div class="alert alert-success">@message</div> }
<div class="row g-4"><div class="col-lg-5"><div class="farmer-card"><div class="farmer-card-header"><div><h3>Add seed stock</h3><span>Record new seed received on your farm.</span></div></div><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger small"></div><label class="form-label">Crop name</label><input asp-for="Input.CropName" class="form-control mb-3" placeholder="Tomato - Roma" /><label class="form-label">Maturity days</label><input asp-for="Input.MaturityDays" class="form-control mb-3" /><div class="row"><div class="col-8"><label class="form-label">Quantity</label><input asp-for="Input.Quantity" class="form-control" /></div><div class="col-4"><label class="form-label">Unit</label><select asp-for="Input.Unit" class="form-select"><option>kg</option><option>bags</option><option>packets</option></select></div></div><button class="btn btn-success mt-4"><i class="bi bi-plus-lg me-1"></i> Add stock</button></form></div></div><div class="col-lg-7"><div class="farmer-card"><div class="farmer-card-header"><div><h3>Available stock</h3><span>@Model.Stock.Count seed item(s)</span></div></div>@if (!Model.Stock.Any()) { <div class="farmer-empty"><i class="bi bi-box-seam"></i><h5>No seed stock recorded</h5><p>Add stock before recording a planting batch.</p></div> } else { <div class="table-responsive"><table class="table farmer-table"><thead><tr><th>Crop</th><th>Maturity</th><th>Available</th><th>Updated</th></tr></thead><tbody>@foreach (var item in Model.Stock) { <tr><td><strong>@item.CropName</strong></td><td>@item.MaturityDays days</td><td><strong>@item.CurrentStock.ToString("0.##") @item.Unit</strong></td><td>@item.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy")</td></tr>}</tbody></table></div> }</div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }