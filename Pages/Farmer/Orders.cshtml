@page
@model AgriFlow.Pages.Farmer.OrdersModel
@{ Layout="_FarmerLayout"; ViewData["Title"]="Sales & orders"; }
<div class="farmer-page"><div class="farmer-heading"><div><div class="farmer-eyebrow">SALES MANAGEMENT</div><h1>Sales & orders</h1><p>Confirm buyer orders, dispatch produce, and complete delivery.</p></div></div><div class="farmer-card"><div class="farmer-card-header"><div><h3>Buyer orders</h3><span>@Model.Orders.Count order line(s)</span></div></div>@if(!Model.Orders.Any()){<div class="farmer-empty"><i class="bi bi-truck"></i><h5>No buyer orders yet</h5><p>Orders from buyers will appear here when they reserve your listings.</p></div>}else{<div class="table-responsive"><table class="table farmer-table"><thead><tr><th>Order</th><th>Produce</th><th>Quantity</th><th>Total</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var item in Model.Orders){<tr><td>#@item.OrderId<small>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small></td><td><strong>@item.CropName</strong></td><td>@item.Quantity.ToString("0.##") @item.Unit</td><td>RWF @item.TotalAmount.ToString("N0")</td><td><span class="badge bg-light text-dark">@item.Status</span></td><td><form method="post" asp-page-handler="Status" class="d-flex gap-1"><input type="hidden" name="orderId" value="@item.OrderId" />@if(item.Status=="pending"){<button name="status" value="confirmed" class="btn btn-sm btn-success">Confirm</button>}else if(item.Status=="confirmed"){<button name="status" value="dispatched" class="btn btn-sm btn-primary">Dispatch</button>}else if(item.Status=="dispatched"){<button name="status" value="delivered" class="btn btn-sm btn-success">Mark delivered</button>}else{<span class="text-muted small">No action</span>}</form></td></tr>}</tbody></table></div>}</div></div>