@page
@model AgriFlow.Pages.Farmer.ListingsModel
@{ Layout="_FarmerLayout"; ViewData["Title"]="My listings"; }
<div class="farmer-page"><div class="farmer-heading"><div><div class="farmer-eyebrow">MARKETPLACE</div><h1>My listings</h1><p>Publish available harvest for buyers to reserve.</p></div></div>@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}@if(Model.Error is not null){<div class="alert alert-warning">@Model.Error</div>}
<div class="row g-4"><div class="col-lg-5"><div class="farmer-card"><div class="farmer-card-header"><div><h3>Create listing</h3><span>Choose an active planting batch.</span></div></div><form method="post" asp-page-handler="Create"><label class="form-label">Planting batch</label><select asp-for="BatchId" class="form-select mb-3" required><option value="">Select batch</option>@foreach(var item in Model.Batches.Where(x=>x.Status=="Active")){<option value="@item.Id">@item.CropName — @item.QuantityPlanted.ToString("0.##") planted — harvest @item.PredictedHarvestDate.ToString("dd MMM yyyy")</option>}</select><label class="form-label">Available quantity</label><input asp-for="Quantity" class="form-control mb-3" min="0.01" step="0.01" required /><label class="form-label">Price per unit (RWF)</label><input asp-for="PricePerUnit" class="form-control mb-3" min="0.01" step="0.01" required /><label class="form-label">Unit</label><select asp-for="Unit" class="form-select"><option value="kg">kg</option><option value="crate">crate</option><option value="bag">bag</option><option value="tonne">tonne</option></select><button class="btn btn-success mt-4"><i class="bi bi-plus-lg me-1"></i> Publish listing</button></form></div></div><div class="col-lg-7"><div class="farmer-card"><div class="farmer-card-header"><div><h3>Published listings</h3><span>@Model.Listings.Count listing(s)</span></div></div>@if(!Model.Listings.Any()){<div class="farmer-empty"><i class="bi bi-tag"></i><h5>No listings yet</h5><p>Create a listing so buyers can find your harvest.</p></div>}else{<div class="table-responsive"><table class="table farmer-table"><thead><tr><th>Crop</th><th>Quantity</th><th>Price</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var item in Model.Listings){<tr><td><strong>@item.CropName</strong><small>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small></td><td>@item.AvailableQuantity.ToString("0.##") @item.Unit</td><td>RWF @item.PricePerUnit.ToString("N0")</td><td><span class="badge @(item.IsActive?"bg-success":"bg-secondary")">@(item.IsActive?"Open":"Hidden")</span></td><td><form method="post" asp-page-handler="Toggle"><input type="hidden" name="listingId" value="@item.Id" /><input type="hidden" name="active" value="@(!item.IsActive)" /><button class="btn btn-sm btn-outline-secondary">@(item.IsActive?"Hide":"Publish")</button></form></td></tr>}</tbody></table></div>}</div></div></div></div>
