@page
@model AgriFlow.Pages.Farmer.PlantingModel
@{ Layout="_FarmerLayout"; ViewData["Title"]="Planting batches"; }
<div class="farmer-page"><div class="farmer-heading"><div><div class="farmer-eyebrow">FARM PRODUCTION</div><h1>Record planting</h1><p>Seed is deducted from stock and a new growing batch is created.</p></div></div>@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> } @if (Model.Error is not null) { <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i>@Model.Error</div> }
<div class="row g-4"><div class="col-lg-6"><div class="farmer-card"><div class="farmer-card-header"><div><h3>Planting details</h3><span>What you planted and when.</span></div></div><form method="post"><label class="form-label">Seed stock</label><select asp-for="StockId" class="form-select mb-3" required><option value="">Select seed stock</option>@foreach(var item in Model.Stock) { <option value="@item.Id">@item.CropName — @item.CurrentStock.ToString("0.##") @item.Unit available</option> }</select><label class="form-label">Quantity planted</label><input asp-for="Quantity" class="form-control mb-3" min="0.01" step="0.01" required /><div class="form-text mb-3">The quantity cannot exceed the selected available stock.</div><label class="form-label">Planting date</label><input asp-for="PlantingDate" type="date" class="form-control" required /><button class="btn btn-success mt-4"><i class="bi bi-check-lg me-1"></i> Save planting</button></form></div></div><div class="col-lg-6"><div class="farmer-card"><div class="farmer-card-header"><div><h3>Recorded batches</h3><span>Monitor expected harvest dates.</span></div></div>@if (!Model.Batches.Any()) { <div class="farmer-empty"><i class="bi bi-flower1"></i><h5>No planting batches yet</h5><p>Add seed stock, then record your first planting.</p></div> } else { <div class="table-responsive"><table class="table farmer-table"><thead><tr><th>Crop</th><th>Planted</th><th>Harvest date</th><th>Status</th></tr></thead><tbody>@foreach(var item in Model.Batches) { <tr><td><strong>@item.CropName</strong><small>@item.QuantityPlanted.ToString("0.##") planted</small></td><td>@item.PlantingDate.ToString("dd MMM yyyy")</td><td>@item.PredictedHarvestDate.ToString("dd MMM yyyy")</td><td><span class="badge bg-success">@item.Status</span></td></tr>}</tbody></table></div> }</div></div></div></div>